# Copy this file to .env and replace DB_PASSWORD before the first start.
DB_NAME=vaultcore
DB_USER=vaultcore
DB_PASSWORD=replace-with-a-local-password
DB_PORT=55432
DB_URL=jdbc:postgresql://localhost:55432/vaultcore
# Docker Compose uses this host port; the application listens on 8080 inside the container.
API_PORT=8080
# Local development only. Use default plus an external issuer for deployed environments.
SPRING_PROFILES_ACTIVE=dev
JWT_ISSUER_URI=http://localhost:8180/realms/vaultcore
JWT_AUDIENCE=vaultcore-api
